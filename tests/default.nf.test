nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            // The test sample sheet points at the read files on the GitHub `main` branch, so
            // that `-profile test` runs from anywhere. Point them at this checkout instead, in
            // a copy of the sample sheet: the test then needs no network and runs on the read
            // files of the branch under test.
            def samplesheet = new File("${outputDir}/samplesheet_test.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = new File("${baseDir}/tests/data/samplesheet_test.csv").text
                .replace('https://raw.githubusercontent.com/dsamoht/isolate-wf/main/tests/data/', "${baseDir}/tests/data/")

            params {
                input  = samplesheet.toString()
                outdir = "$outputDir"
            }
        }

        then {
            // No snapshot: the assemblers are not reproducible from one run to the next, and
            // everything Autocycler builds on them - clusters, consensus, CheckM2 scores -
            // differs in turn.
            assert workflow.success
            ['test1', 'test2'].each { sample ->
                assert path("$outputDir/sample_${sample}/autocycler_final/consensus_assembly.fasta").exists()
                assert path("$outputDir/sample_${sample}/autocycler_final/consensus_assembly.gfa").exists()
                assert path("$outputDir/sample_${sample}/autocycler_final/${sample}_autocycler_metrics.tsv").exists()
                assert path("$outputDir/sample_${sample}/autocycler_clustering/clustering.tsv").exists()
            }
            // A header, then one line per sample
            assert path("$outputDir/autocycler_metrics.tsv").readLines().size() == 3
            assert path("$outputDir/pipeline_info/isolate-wf_software_mqc_versions.yml").exists()
        }
    }
}
