/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run dsamoht/isolate-wf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // GitHub-hosted runners have 4 vCPUs and 16 GB of memory
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input          = "${projectDir}/tests/data/samplesheet_test.csv"

    // Output directory
    outdir         = "${projectDir}/tests/isolate-wf_out"

    // Keep the test short
    skip_porechop    = true
    skip_nanoplot    = true

    // Only the three fastest assemblers on the test reads: Raven, miniasm and metaMDBG.
    // Canu is skipped too, it aborts on the resources of a GitHub runner.
    skip_flye        = true
    skip_plassembler = true
    skip_canu        = true
    skip_myloasm     = true
    skip_necat       = true
    skip_nextdenovo  = true

    // The test reads assemble into a ~100 kb consensus that DIAMOND finds no hit in, and
    // CheckM2 exits with an error instead of writing a report for it
    skip_checkm2     = true
}
