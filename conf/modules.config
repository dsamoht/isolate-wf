/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output paths are declared in the `output` block of main.nf (Nextflow workflow
    outputs), not with publishDir directives.
----------------------------------------------------------------------------------------
*/

process {

    // ---------------------------------------------------------------------- QC
    withName: 'PORECHOP_ABI' {
        ext.args = '--ab_initio --discard_middle'
    }
    withName: 'CHOPPER' {
        ext.args = { "-l ${params.chopper_minlength} -q ${params.chopper_minq}" }
    }
    withName: 'NANOPLOT_RAW' {
        ext.prefix = { "${meta.id}_raw" }
    }
    withName: 'NANOPLOT_QC' {
        ext.prefix = { "${meta.id}_qc" }
    }

    // ---------------------------------------------------------------- Assembly
    withName: 'AUTOCYCLER_ASSEMBLE' {
        ext.args = '--min_depth_rel 0.1'
    }
    // Before compressing, the assemblies with more than
    // max(outlier_min_limit, outlier_factor x median) contigs are left out, and the sample
    // fails if fewer than min_kept_fraction of its non-empty assemblies remain.
    // outlier_min_limit follows `--max_contigs` when it is set in ext.args (25 otherwise).
    withName: 'AUTOCYCLER_COMPRESS' {
        ext.outlier_factor    = 5
        ext.min_kept_fraction = 0.5
        // ext.outlier_min_limit = 25
    }

    // ------------------------------------------------------------ Genome QC
    withName: 'DNAAPLER' {
        ext.args = ''
    }
    withName: 'CHECKM2' {
        ext.args = ''
    }
    withName: 'GENOMAD' {
        ext.args = ''
    }

    // ------------------------------------------------------------ Run level
    // GTDB-Tk 2.x needs either a Mash database for its ANI screen or --skip_ani_screen
    withName: 'GTDBTK_CLASSIFYWF' {
        ext.args = '--skip_ani_screen'
    }
    withName: 'SKANI_TRIANGLE' {
        ext.args    = '--slow'
        ext.min_ani = { params.dedup_min_ani }
        ext.min_af  = { params.dedup_min_af }
    }

    // ------------------------------------------------------------------ Report
    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }
}
