/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    dsamoht/isolate-wf Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    // Retry once on the exit codes of a task killed for its resources. Otherwise, with
    // --skip_failed_samples (the default), a failed task only ends its own sample: its later
    // steps are not run, the summary log of the sample says where it stopped, and the
    // other samples carry on.
    errorStrategy = {
        task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 1 ? 'retry'
            : (params.skip_failed_samples ? 'ignore' : 'finish')
    }
    maxRetries    = 1
    maxErrors     = '-1'

    // Requests grow with every retry; past these caps a task would ask for more than a
    // machine has and never be scheduled. Lower them to the largest node available.
    resourceLimits = [
        cpus: 32,
        memory: 256.GB,
        time: 72.h
    ]

    // Process-specific resource requirements
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel:process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    // Raven assembles all the QC'd reads to estimate the genome size, so its memory grows
    // with the yield: 16 GB per GB of gzipped reads (about 1.5 Gb of sequence), 16 GB at
    // least. A sample of 6 Gb was killed at 16 GB and passed at 64 GB. Raven reports that kill
    // as exit status 1, retried once with twice the memory; a second exit 1 is a real failure.
    withName:'AUTOCYCLER_GENOME_SIZE' {
        memory        = { [16.GB, 16.GB * Math.ceil(reads.size() / 1e9)].max() * task.attempt }
        errorStrategy = {
            (task.exitStatus in ((130..145) + 104 + (175..177)) || (task.exitStatus == 1 && task.attempt == 1)) && task.attempt <= 2 ? 'retry'
                : (params.skip_failed_samples ? 'ignore' : 'finish')
        }
        maxRetries    = 2
    }

    // Run-level steps: their failure is not one sample's, so it always stops the run
    withName:'MULTIQC|GTDBTK_CLASSIFYWF|SKANI_TRIANGLE' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 1 ? 'retry' : 'finish' }
    }

    // GTDB-Tk classify_wf: 45 min with 16 CPUs and 128 GB for 34 genomes (GTDB R226)
    withName:'GTDBTK_CLASSIFYWF' {
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // Canu, NECAT and NextDenovo are the slowest of the assemblers run on every read subset
    withName:'AUTOCYCLER_ASSEMBLE' {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
